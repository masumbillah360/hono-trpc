meta {
  name: hello
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/hello
  body: none
  auth: bearer
}

params:query {
  ~name: 
}

auth:bearer {
  token: {{token}}
}

example {
  name: 200 Response
  description: Successful response
  
  request: {
    url: {{baseUrl}}/hello
    method: GET
    mode: none
    params:query: {
      ~name: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

